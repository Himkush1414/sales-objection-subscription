# Google Gemini API key — get a free key at https://aistudio.google.com/app/apikey
# Preferred (server-only, not exposed to the browser):
GEMINI_API_KEY=your_key_here

# Also supported for compatibility with the assignment brief.
# If set, it is used as a fallback. Prefer GEMINI_API_KEY above.
# NEXT_PUBLIC_GEMINI_API_KEY=your_key_here

# Optional: override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
